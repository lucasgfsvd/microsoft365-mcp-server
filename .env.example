# microsoft365-mcp-server — example environment file.
# Copy to .env (which is gitignored) and edit. Every variable also has a CLI
# flag equivalent; flags win when both are set.

# --- Authentication ----------------------------------------------------------

# device-code (default) | client-credentials | interactive
MCP_AUTH_MODE=device-code

# Azure AD tenant. Use 'common' (any tenant + personal accounts), 'organizations'
# (any tenant), 'consumers' (personal only), or a tenant GUID.
MCP_TENANT_ID=common

# Entra app (client) ID. The default is Microsoft's public "Graph Command Line
# Tools" client — convenient for trying things out but noisy in audit logs.
# Register your own app for real use and put its ID here.
# MCP_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# client-credentials (app-only) mode: a certificate (PEM with private key) is
# preferred to a secret. Never commit a real value.
# MCP_CLIENT_CERTIFICATE_PATH=
# MCP_CLIENT_CERTIFICATE_PASSWORD=
# MCP_CLIENT_SECRET=

# client-credentials mode: the user (or shared mailbox) the server works for.
# An app-only token has no signed-in user, so this is required there.
# MCP_USER=

# Signed-in modes: let mail and calendar tools open shared mailboxes and
# calendars you are a delegate of (adds the .Shared scopes; sign in again once).
# MCP_ENABLE_SHARED_MAILBOXES=false

# Used by the interactive auth flow only.
# MCP_REDIRECT_URI=http://localhost:3000

# --- Scopes ------------------------------------------------------------------

# Comma-separated Graph scopes. Leave unset to use the built-in defaults
# (read-only, plus write scopes when MCP_ENABLE_WRITES is set).
# MCP_SCOPES=User.Read,offline_access,Mail.Read

# --- Write protection --------------------------------------------------------

# All mutating tools are hidden from tools/list until you opt in. Set to
# 'true' to unlock everything, or use a per-surface flag below.
# MCP_ENABLE_WRITES=false

# Per-surface write enablement (use any combination):
# MCP_ENABLE_MAIL_WRITE=false
# MCP_ENABLE_CALENDAR_WRITE=false
# MCP_ENABLE_CONTACTS_WRITE=false
# MCP_ENABLE_FILES_WRITE=false
# MCP_ENABLE_TEAMS_WRITE=false
# MCP_ENABLE_TASKS_WRITE=false
# MCP_ENABLE_ONENOTE_WRITE=false
# MCP_ENABLE_EXCEL_WRITE=false
# MCP_ENABLE_WORD_WRITE=false
# MCP_ENABLE_POWERPOINT_WRITE=false

# Comma-separated tool names to hide entirely (overrides any of the above).
# MCP_DISABLED_TOOLS=mail_delete_message,files_delete

# --- Storage & logging -------------------------------------------------------

# Where to persist the OAuth token cache. Default: ~/.microsoft365-mcp/tokencache.json
# MCP_TOKEN_CACHE_PATH=

# Keep the tokens in MCP_TOKEN_CACHE_PATH, encrypted with this key, instead of the
# OS keyring: for hosts that have none, like the Docker image. 16+ characters;
# generate with `openssl rand -base64 32`. Never commit a real value.
# MCP_TOKEN_CACHE_KEY=

# Local files. files_download may stream into MCP_DOWNLOAD_DIR (saveToDisk), and
# files_upload may read a localPath from MCP_UPLOAD_DIR, at any size. Each is off
# while unset; nothing outside the folder can be read or written through it.
# MCP_DOWNLOAD_DIR=
# MCP_UPLOAD_DIR=

# Pino log level (logs go to stderr; stdout is reserved for the MCP protocol).
# trace | debug | info | warn | error | fatal
MCP_LOG_LEVEL=info
