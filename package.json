{
  "name": "@microsoft365-mcp/server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Microsoft 365 — Mail, Calendar, Files, Teams, OneNote, Excel, Word, PowerPoint and more via Microsoft Graph.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microsoft-365",
    "microsoft-graph",
    "outlook",
    "onedrive",
    "sharepoint",
    "teams",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "author": "lucasgfsvd (https://github.com/lucasgfsvd)",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasgfsvd/microsoft365-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/lucasgfsvd/microsoft365-mcp-server/issues"
  },
  "homepage": "https://github.com/lucasgfsvd/microsoft365-mcp-server#readme",
  "type": "module",
  "bin": {
    "microsoft365-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/identity-cache-persistence": "^1.3.0",
    "@azure/msal-node": "^3.2.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.1.0",
    "docx": "^9.0.0",
    "exceljs": "^4.4.0",
    "isomorphic-fetch": "^3.0.0",
    "pino": "^9.5.0",
    "pizzip": "^3.1.7",
    "pptx-automizer": "^0.7.0",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "nock": "^14.0.0-beta.19",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^2.1.5"
  }
}
