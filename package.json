{
  "name": "@microsoft365-mcp/server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Microsoft 365 \u2014 Mail, Calendar, Files, Teams, OneNote, Excel, Word, PowerPoint and more via Microsoft Graph.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microsoft-365",
    "microsoft-graph",
    "outlook",
    "onedrive",
    "sharepoint",
    "teams",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "author": "lucasgfsvd (https://github.com/lucasgfsvd)",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasgfsvd/microsoft365-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/lucasgfsvd/microsoft365-mcp-server/issues"
  },
  "homepage": "https://github.com/lucasgfsvd/microsoft365-mcp-server#readme",
  "type": "module",
  "bin": {
    "microsoft365-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:notice": "node scripts/generate-notice.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/identity-cache-persistence": "^1.3.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "docx": "^9.0.0",
    "exceljs": "^4.4.0",
    "pino": "^10.3.1",
    "pizzip": "^3.1.7",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@types/node": "^25.9.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "nock": "^14.0.17",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "image-size": "^2.0.4",
    "brace-expansion": "^2.1.7",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.8",
    "@hono/node-server": "^1.19.17",
    "body-parser": "^2.3.0",
    "qs": "^6.16.0",
    "express-rate-limit": "^8.7.0",
    "ip-address": "^10.7.2",
    "nanoid": "^5.1.16",
    "tmp": "^0.2.7"
  }
}
